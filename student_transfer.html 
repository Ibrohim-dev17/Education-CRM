<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>O'quvchi transferi</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        body { background-color: #fff; color: #111; display: flex; flex-direction: column; min-height: 100vh; max-width: 480px; margin: 0 auto; position: relative; }
        .content { flex: 1; overflow-y: auto; padding: 16px 20px 90px 20px; display: flex; flex-direction: column; gap: 16px; }
        .app-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: #fff; position: sticky; top: 0; z-index: 10; border-bottom: 1px solid #F0F2F5; }
        .app-header h1 { font-size: 17px; font-weight: 600; color: #111; }
        .action-btn { background: none; border: none; cursor: pointer; display: flex; align-items: center; color: #111; text-decoration: none; }
        
        .student-profile-card { display: flex; align-items: center; gap: 12px; background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 14px; padding: 12px 16px; }
        .student-avatar { width: 44px; height: 44px; border-radius: 50%; background: #0066FF; display: flex; align-items: center; justify-content: center; font-weight: 600; color: #fff; }
        .student-details h3 { font-size: 14px; font-weight: 600; color: #111; margin-bottom: 2px; }
        .student-details p { font-size: 12px; color: #6B7280; }
        
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .form-group label { font-size: 12px; font-weight: 600; color: #4B5563; }
        .form-group select, .form-group input, .form-group textarea { padding: 12px; border: 1px solid #E5E7EB; border-radius: 12px; font-size: 14px; background: #F9FAFB; outline: none; width: 100%; }
        .form-group textarea { resize: none; height: 80px; }
        .form-group select:focus, .form-group input:focus, .form-group textarea:focus { border-color: #0066FF; background: #fff; }
        
        .date-input-wrap { position: relative; display: flex; align-items: center; }
        .date-input-wrap svg { position: absolute; right: 12px; pointer-events: none; }
        
        .btn-submit { background: #0066FF; color: #fff; border: none; width: 100%; padding: 14px; border-radius: 12px; font-weight: 600; font-size: 14px; cursor: pointer; text-align: center; margin-top: 10px; transition: background 0.2s; }
        .btn-submit:hover { background: #0052cc; }

        /* Pastki navigatsiya */
        .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; max-width: 480px; margin: 0 auto; height: 75px; background: #ffffff; border-top: 1px solid #F0F2F5; display: flex; justify-content: space-around; align-items: center; padding: 0 10px 10px 10px; z-index: 100; }
        .nav-item { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: #9CA3AF; font-size: 10px; gap: 4px; flex: 1; }
        .nav-item.active { color: #0066FF; }
        .nav-item svg { width: 22px; height: 22px; fill: currentColor; }
        .nav-center-btn-wrapper { flex: 1; display: flex; justify-content: center; position: relative; top: -14px; }
        .nav-center-btn { width: 48px; height: 48px; background-color: #0066FF; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: none; box-shadow: 0 4px 12px rgba(0,102,255,0.4); cursor: pointer; color: #fff; text-decoration: none; }
    </style>
</head>
<body>
    <div class="app-header">
        <h1>O'quvchi transferi</h1>
        <a href="students.html" class="action-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
        </a>
    </div>

    <div class="content">
        <!-- O'quvchi ma'lumotlari kartasi -->
        <div class="student-profile-card" id="studentCard">
            <div class="student-avatar" id="studentAvatar">O</div>
            <div class="student-details" id="studentDetails">
                <h3>O'quvchi tanlanmagan</h3>
                <p>-</p>
            </div>
        </div>

        <div class="form-group">
            <label>O'quvchini tanlash*</label>
            <select id="studentSelect" onchange="selectStudent()">
                <option value="">O'quvchini tanlang</option>
            </select>
        </div>

        <div class="form-group">
            <label>Qaysi guruhdan*</label>
            <input type="text" id="fromGroup" readonly placeholder="Avval o'quvchini tanlang" style="background-color: #E5E7EB; cursor: not-allowed;">
        </div>

        <div class="form-group">
            <label>Qaysi guruhga*</label>
            <select id="toGroup">
                <option value="">Yangi guruhni tanlang</option>
                <option value="A1-1 guruhi">A1-1 guruhi</option>
                <option value="A1-2 guruhi">A1-2 guruhi</option>
                <option value="B2-1 guruhi">B2-1 guruhi</option>
                <option value="C1-1 guruhi">C1-1 guruhi</option>
            </select>
        </div>

        <div class="form-group">
            <label>Transfer sanasi*</label>
            <div class="date-input-wrap">
                <input type="text" id="transferDate" placeholder="KK.MM.YYYY">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
        </div>

        <div class="form-group">
            <label>Sabab (ixtiyoriy)</label>
            <textarea id="transferReason" placeholder="Sababni kiriting..."></textarea>
        </div>

        <button class="btn-submit" onclick="executeTransfer()">Transferni amalga oshirish</button>
    </div>

    <!-- Pastki menyu -->
    <div class="bottom-nav">
        <a href="index.html" class="nav-item"><svg viewBox="0 0 24 24"><path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z"/></svg><span>Bosh sahifa</span></a>
        <a href="students.html" class="nav-item active"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg><span>O'quvchilar</span></a>
        <div class="nav-center-btn-wrapper"><a href="add_student.html" class="nav-center-btn"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></a></div>
        <a href="payments.html" class="nav-item"><svg viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg><span>To'lovlar</span></a>
        <a href="teachers.html" class="nav-item"><svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg><span>Menyu</span></a>
    </div>

    <script>
        // Sahifa yuklanganda localStorage'dagi o'quvchilarni select elementiga qo'shish
        window.onload = function() {
            loadStudentsToSelect();
            setTodayDate();
        };

        function setTodayDate() {
            const dateObj = new Date();
            const day = String(dateObj.getDate()).padStart(2, '0');
            const month = String(dateObj.getMonth() + 1).padStart(2, '0');
            const year = dateObj.getFullYear();
            document.getElementById('transferDate').value = `${day}.${month}.${year}`;
        }

        function loadStudentsToSelect() {
            const students = JSON.parse(localStorage.getItem('students')) || [];
            const select = document.getElementById('studentSelect');
            
            students.forEach((student, index) => {
                const option = document.createElement('option');
                option.value = index;
                option.textContent = student.name + (student.group ? ` (${student.group})` : '');
                select.appendChild(option);
            });
        }

        function selectStudent() {
            const index = document.getElementById('studentSelect').value;
            const students = JSON.parse(localStorage.getItem('students')) || [];
            
            const avatarEl = document.getElementById('studentAvatar');
            const detailsEl = document.getElementById('studentDetails');
            const fromGroupInput = document.getElementById('fromGroup');

            if (index === "" || !students[index]) {
                avatarEl.textContent = "O";
                detailsEl.innerHTML = `<h3>O'quvchi tanlanmagan</h3><p>-</p>`;
                fromGroupInput.value = "";
                return;
            }

            const student = students[index];
            avatarEl.textContent = student.name ? student.name.charAt(0).toUpperCase() : 'O';
            detailsEl.innerHTML = `
                <h3>${student.name}</h3>
                <p>ID: ${student.id || 'N/A'} • ${student.phone || 'Telefon belgilanmagan'}</p>
            `;
            fromGroupInput.value = student.group || 'Guruh biriktirilmagan';
        }

        function executeTransfer() {
            const index = document.getElementById('studentSelect').value;
            const toGroup = document.getElementById('toGroup').value;

            if (index === "") {
                alert("Iltimos, transfer qilinadigan o'quvchini tanlang!");
                return;
            }

            if (!toGroup) {
                alert("Iltimos, o'quvchi o'tkaziladigan yangi guruhni tanlang!");
                return;
            }

            let students = JSON.parse(localStorage.getItem('students')) || [];
            if (students[index]) {
                const oldGroup = students[index].group;
                students[index].group = toGroup;
                
                // LocalStorage'ni yangilash
                localStorage.setItem('students', JSON.stringify(students));

                alert(`Muvaffaqiyatli! O'quvchi ${oldGroup}dan ${toGroup}ga ko'chirildi.`);
                window.location.href = "students.html";
            }
        }
    </script>
</body>
</html>
